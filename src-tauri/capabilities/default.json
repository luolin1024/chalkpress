{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/chalkpress-core", "sidecar": true }
      ]
    }
  ]
}
